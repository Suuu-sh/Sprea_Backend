# ローカルは必ずモック。本番は SPREA_ENV=production / live に変更する。
SPREA_ENV=local
SPREA_COLLECTOR_MODE=mock
SPREA_DRY_RUN=true
SPREA_API_URL=http://localhost:8080
SPREA_INGEST_API_KEY=change-me

# 本番のliveモードでのみ必須
RAKUTEN_APPLICATION_ID=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_KEYWORD=Nintendo Switch
RAKUTEN_GENRE_ID=
RAKUTEN_HITS=30
RAKUTEN_APPLE_ONLY=true

# 本番Collectorは rakuten または yahoo
SPREA_COLLECTOR_SOURCE=rakuten
YAHOO_CLIENT_ID=
YAHOO_QUERY=Apple iPhone iPad AirPods Apple Watch MacBook 新品
YAHOO_RESULTS=30

# 異常時は取り込みを停止し、任意のWebhookへ通知
SPREA_MIN_ITEMS=1
SPREA_ALERT_WEBHOOK_URL=
