# ローカルは必ずモック。本番は SPREA_ENV=production / live に変更する。
SPREA_ENV=local
SPREA_COLLECTOR_MODE=mock
SPREA_DRY_RUN=true
SPREA_API_URL=http://localhost:8080
SPREA_INGEST_API_KEY=change-me

# 本番のliveモードでのみ必須
RAKUTEN_APPLICATION_ID=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_KEYWORD=Nintendo Switch
RAKUTEN_GENRE_ID=
RAKUTEN_HITS=30
