{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprea-research",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-23",
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sprea-research",
    "database_id": "fd7fd41c-c2d0-4733-8422-6242d49e15cd",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "MODELS",
    "bucket_name": "sprea-models",
    "preview_bucket_name": "sprea-models-preview"
  }],
  "vars": {
    "COLLECTOR_MODE": "live",
    "SPREA_ENV": "production",
    "SPREA_COLLECTOR_SOURCE": "yahoo",
    "ALLOWED_ORIGIN": "https://sprea-frontend.pages.dev",
    "YAHOO_QUERY": "Apple 新品 J/A 128GB"
  }
}
